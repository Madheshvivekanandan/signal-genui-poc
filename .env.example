# Copy to .env for `docker compose up`; compose reads this file automatically.
# The non-Docker path uses backend/.env instead — see the README.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Comma-separated. Only needed when the browser talks to the backend directly;
# the Docker build proxies /api through nginx, so it is same-origin there.
ALLOWED_ORIGINS=http://localhost:5173
